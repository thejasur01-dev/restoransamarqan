{
  "name": "afisha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db": "tsx scripts/db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test:sales": "node tests/sale-api.test.mjs",
    "test:payment": "node --env-file=.env.local --conditions=react-server --import tsx tests/payment.test.mts",
    "test:auth": "node tests/auth.test.mjs",
    "sms:test": "node --env-file=.env.local --import tsx scripts/sms-test.mts",
    "admin:create": "node --env-file=.env.local --import tsx scripts/admin-create.mts",
    "test:admin": "node --env-file=.env.local --conditions=react-server --import tsx tests/admin.test.mts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "jsqr": "^1.4.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^17.11.0-beta.19"
  }
}
