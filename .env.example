# PostgreSQL connection. Locally `npm run db` starts PostgreSQL 17 from node_modules on port 5433.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Connections per app instance. Keep (instances x DB_POOL_MAX) below the server max_connections.
DB_POOL_MAX=10

# Public base URL, used for canonical links and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for hashing login codes and session tokens. Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-change-me

# Login code delivery. Telegram is tried first, SMS is the fallback. With neither set,
# development shows the code on screen; production refuses to start sending codes.
TELEGRAM_GATEWAY_TOKEN=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender name approved by Eskiz (default test sender is 4546)
ESKIZ_FROM=4546
# Must match an SMS template approved in the Eskiz cabinet; {code} is replaced with the code
ESKIZ_TEMPLATE={code} - Chipta saytiga kirish kodi. Hech kimga bermang.
